# Google Maps API Key (already configured in Anything platform)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Kajabi Landing Page URL for Email Alerts
NEXT_PUBLIC_KAJABI_ALERTS_URL=https://your-kajabi-site.com/compliance-alerts

# Database URL (if using database features)
DATABASE_URL=your_database_url

# Auth Secret (if using authentication)
AUTH_SECRET=your_auth_secret
BETTER_AUTH_SECRET=your_better_auth_secret
BETTER_AUTH_URL=http://localhost:3000
